{% extends 'base.html.twig' %}

{% block body %}
<div class="dashboard">
    <aside class="dashboard-sidebar">
        <div class="dashboard-brand">ReserveHub</div>

        <nav class="dashboard-nav">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_user_crud_index') }}">Użytkownicy</a>
            {% endif %}

            <a href="{{ path('app_item_index') }}">Lista zasobów</a>
            <a href="{{ path('app_logout') }}">Wyloguj</a>
        </nav>
    </aside>

    <main class="dashboard-main">
        {% block content %}{% endblock %}
    </main>
</div>
{% endblock %}